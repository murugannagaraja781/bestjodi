# ==========================================
# BestJodi Matrimony - Environment Config
# ==========================================

# Application Settings
APP_ENV=production
APP_PORT=8080
APP_URL=http://localhost:8080

# Database Configuration (Docker container service name is 'db')
DB_HOST=db
DB_PORT=3306
DB_DATABASE=bestjodi
DB_USER=best_jodi_user
DB_PASSWORD=bestjodi_secure_pass_2026
MYSQL_ROOT_PASSWORD=bestjodi_root_secret_2026

# Optional phpMyAdmin port (for database management UI)
PMA_PORT=8081

# PHP Performance & Upload Limits
PHP_MEMORY_LIMIT=256M
PHP_UPLOAD_MAX_FILESIZE=64M
PHP_POST_MAX_SIZE=64M
PHP_MAX_EXECUTION_TIME=300

# Backup Retention (days)
BACKUP_RETENTION_DAYS=14
